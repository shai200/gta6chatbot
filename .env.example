# Copy to .env and fill in your key (create one in the BetterProxy dashboard → API Keys)
BETTERPROXY_API_KEY=llms_live_...
BETTERPROXY_BASE_URL=https://api.betterproxy.ai/v1
BETTERPROXY_MODEL=gpt-5.4
PORT=3000

# Optional: require /monitor?token=... to view cache monitoring
# MONITOR_TOKEN=

# Community tips. All of these have safe defaults. Leave them unset.
# Tips are stored in a local SQLite file. No database account is required.
# COMMUNITY_DB=data/community.db
# DAILY_REQUEST_CAP=150
# QUESTION_LIMIT=20
# QUESTION_WINDOW_SEC=600
# TIP_LIMIT=8
# TIP_WINDOW_SEC=3600
# VOTE_LIMIT=60
# VOTE_WINDOW_SEC=3600
# TRUST_UPVOTES=3
# HIDE_FLAGS=3
# Set MODERATION_LLM=0 to skip the optional tip check and use the rule filter only.
# MODERATION_LLM=1
